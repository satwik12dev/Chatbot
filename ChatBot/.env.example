MAX_AUDIO_SIZE_MB=25
MAX_CONTEXT_MESSAGES=30
MAX_PAGE_SIZE=50

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Brevo (Sendinblue) SMTP Configuration
